# -------------------------------------------------------------
# HireLens AI — Environment Configuration Template (.env.example)
# -------------------------------------------------------------

# Application Core Settings
PROJECT_NAME="HireLens AI"
ENVIRONMENT="production"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-random-64-char-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
DEFAULT_TIMEZONE="Asia/Kolkata"

# Database Configuration
# Local development default:
# DATABASE_URL="sqlite:///./hirelens.db"
# Production PostgreSQL:
DATABASE_URL="postgresql+psycopg2://hirelens:hirelens_password@localhost:5432/hirelens_db"

# Background Worker & Message Queue (Redis / Celery)
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Sovereign AI Inference Engine (Ollama / Local / Hosted)
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
LLM_MODEL="qwen2.5:1.5b"
EMBEDDING_MODEL="BAAI/bge-m3"

# Hosted AI Fallback (Optional)
HOSTED_AI_BASE_URL=""
HOSTED_AI_API_KEY=""
HOSTED_AI_MODEL=""

# Storage Configuration
STORAGE_TYPE="local"
LOCAL_STORAGE_PATH="./storage/resumes"

# Token Encryption (Required for OAuth token at-rest encryption via Fernet)
# Must be a 32-byte URL-safe base64-encoded key
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-fernet-key-in-production"

# =============================================================
# External Payment Gateways (Phase 14 Monetization)
# =============================================================

# Razorpay (India / Domestic INR Transactions)
# Obtain from Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe (Global / International USD Transactions)
# Obtain from Stripe Dashboard -> Developers -> API keys & Webhooks
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# =============================================================
# Calendar & OAuth Integrations (Phase 9 Integrations)
# =============================================================
CALENDAR_WEBHOOK_BASE_URL="http://localhost:8000"
USE_MOCK_CALENDAR_PROVIDER=false

# Google OAuth & Calendar API
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="replace-with-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/settings/integrations?provider=google"

# Microsoft Entra ID & Outlook / Microsoft Graph API
# Obtain from Microsoft Entra Admin Center -> App registrations
MICROSOFT_CLIENT_ID="replace-with-azure-app-registration-client-id"
MICROSOFT_CLIENT_SECRET="replace-with-azure-app-client-secret"
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/settings/integrations?provider=microsoft"

# =============================================================
# Transactional Email & SMTP (Phase 7 Communication)
# =============================================================
# Options: "console" (dev), "mock" (tests), "smtp" (production)
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_TLS=true
EMAILS_FROM_EMAIL="noreply@hirelens.ai"
EMAILS_FROM_NAME="HireLens AI"

# Frontend Next.js Public URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
